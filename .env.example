# ─── Groq LLM ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ─── Database (leave blank to use SQLite fallback) ────────────────────────────
# Supabase PostgreSQL — transaction-mode pooler (app connections)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase PostgreSQL — session-mode (DDL / migrations)
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-string

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ─── Observability (optional) ─────────────────────────────────────────────────
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=ai-incident-platform
